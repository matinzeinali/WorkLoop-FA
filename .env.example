# Copy to .env and adjust as needed. All variables use the WORKLOOP_ prefix.
WORKLOOP_HOST=127.0.0.1
WORKLOOP_PORT=8000
WORKLOOP_DEBUG=false

# Folder for the SQLite database and the encryption key file.
WORKLOOP_DATA_DIR=./data
WORKLOOP_DB_FILENAME=workloop.db
WORKLOOP_KEY_FILENAME=secret.key

# Max Boss -> Worker fix rounds per prompt.
WORKLOOP_MAX_ROUNDS=6

# WebSocket heartbeat (seconds): ping interval, and how long to wait for a reply.
WORKLOOP_WS_PING_INTERVAL=30
WORKLOOP_WS_PONG_TIMEOUT=10

# Shell for Boss commands: auto, pwsh, powershell, cmd, bash or sh.
WORKLOOP_SHELL=auto
# Command timeouts in seconds (default and the most a command may ask for).
WORKLOOP_COMMAND_TIMEOUT_DEFAULT=120
WORKLOOP_COMMAND_TIMEOUT_MAX=600

# Agent loop limits per turn (one plan / test / task / fix step).
WORKLOOP_BOSS_MAX_TOOL_CALLS_PER_TURN=60
WORKLOOP_WORKER_MAX_TOOL_CALLS_PER_TURN=80
WORKLOOP_MAX_LLM_CALLS_PER_TURN=100
# Shorten old tool results above this share of the model's context window.
WORKLOOP_CONTEXT_THRESHOLD=0.75
# Context window used when the model's size is unknown.
WORKLOOP_DEFAULT_CONTEXT_WINDOW=128000

# Electron pages loaded from file:// send "Origin: null". Set true to accept it (CORS + WebSocket).
WORKLOOP_ALLOW_NULL_ORIGIN=false
